# Copy this to .secrets and fill in real values for a LOCAL run of
# server.py (`python server.py`). .secrets is gitignored -- never commit
# it, it can hold live tokens and secrets.
#
# For a deployed environment (Render, Fly, etc.) set these in that
# platform's own dashboard/secrets UI instead -- load_dotenv() only fills
# in vars that aren't already set, so real platform env vars always win
# over anything left in .secrets. Nothing below is required just to
# import/run server.py; each subsystem is optional and simply reports as
# "not configured" / "skip" in `run_diagnostics` if you leave it blank.

# --- GitHub Codespaces -------------------------------------------------
# Fine-grained PAT(s), scoped to Codespaces only (ideally on one repo).
# Only GITHUB_TOKEN is required; SECONDARY/TERTIARY are optional extra
# accounts the server automatically falls back to on 401/403.
GITHUB_TOKEN=
GITHUB_TOKEN_SECONDARY=
GITHUB_TOKEN_TERTIARY=

# --- MCP endpoint auth ---------------------------------------------------
# Bearer token Claude must send as `Authorization: Bearer <this>` to
# reach /mcp. REQUIRED once this is reachable from the public internet
# (Render/Fly) -- the server fails closed with a 503 rather than serving
# unauthenticated if this is unset on a public deployment. Not required
# for a purely local `python server.py` run with no host env vars set.
MCP_SERVER_PASSWORD=

# --- Admin dashboard (/admin) --------------------------------------------
# Separate cookie-based login for the browser dashboard. Falls back to
# MCP_SERVER_PASSWORD if left blank. Leaving both unset disables the
# dashboard's login (and, deliberately, cookie verification) entirely --
# it doesn't fall back to a hardcoded secret.
ADMIN_PASSWORD=
# Only set this if you want the HMAC cookie-signing secret to be
# something other than ADMIN_PASSWORD itself (e.g. to rotate the two
# independently). Most setups can leave this blank.
ADMIN_COOKIE_SECRET=

# --- This service's own Render identity (used by /admin to manage
#     itself -- update/redeploy its own env vars) -------------------------
RENDER_API_KEY=
# Optional -- defaults to this project's known service ID if unset.
RENDER_SERVICE_ID=

# --- Deployed hostname ----------------------------------------------------
# No scheme, no path, e.g. `codespaces-mcp.onrender.com`. Auto-detected on
# Render (RENDER_EXTERNAL_HOSTNAME) and Fly (FLY_APP_NAME) -- only set
# this manually on some other host, or to override the auto-detected value.
MCP_ALLOWED_HOST=

# --- Linux home server (server_* tools) -----------------------------------
SERVER_HOST=
SERVER_USER=
SERVER_SSH_PORT=22
# Raw private key text (preferred for deployed environments -- gets
# written to a restricted-permission temp file at startup). Use
# SERVER_SSH_KEY instead for a local run where you already have a key
# file on disk.
SSH_PRIVATE_KEY=
SERVER_SSH_KEY=
# --- Windows PC(s) via organiser-agent (pc_* tools) -----------------------
# Preferred: PCS, a JSON registry of one or more PCs -- see
# ARCHITECTURE.md / BUILD_AND_SETUP.md for the full setup. Example:
#   PCS={"desktop": {"port": 7842, "secret": "..."}, "laptop": {"port": 7843, "secret": "..."}}
PCS=
# Legacy single-PC fallback -- only used if PCS is unset entirely.
ORGANISER_PORT=
ORGANISER_SECRET=

# --- Local run only ---------------------------------------------------------
# Render/Fly set this themselves in production -- only needed for local
# `python server.py` runs.
PORT=8000
