# Copy this to .secrets and fill in real values.
# .secrets is gitignored -- never commit it, it holds a live GitHub token.

# Fine-grained GitHub PAT, scoped to Codespaces only (ideally on one repo).
GITHUB_TOKEN=

# Your deployed public hostname -- no scheme, no path.
# e.g. codespaces-mcp.onrender.com  or  codespaces-mcp.fly.dev
# Leave blank on Render/Fly and it auto-detects from the platform's own
# env vars (RENDER_EXTERNAL_HOSTNAME / FLY_APP_NAME). Set it explicitly
# anywhere else, or to override the auto-detected value.
MCP_ALLOWED_HOST=

# Local port to run on. Render/Fly set this themselves in production --
# only needed for local `python server.py` runs.
PORT=8000
